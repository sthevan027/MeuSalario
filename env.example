NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usado apenas no servidor (webhook, rotas admin). Nunca exponha no client.
SUPABASE_SERVICE_ROLE_KEY=

# Asaas (gateway recomendado para Brasil - cartão, boleto, PIX)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_SANDBOX=true
# true (padrão): cliente só recebe e-mail do Asaas em PAYMENT_RECEIVED (pagamento confirmado).
# Lembretes, vencido, SMS/Whats e demais ficam desligados. false = usa o padrão do painel Asaas.
ASAAS_CUSTOMER_EMAILS_ONLY_PAYMENT_RECEIVED=true

# URL do app (redirects, metadata). Obrigatório em produção.
# Dev: http://localhost:3000
# Produção: https://meu-salario-lime.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Analytics (opcional). Se vazio, o GA não é carregado.
NEXT_PUBLIC_GA_ID=

# Sentry (monitoramento de erros) - opcional
# Crie uma conta em https://sentry.io e obtenha o DSN do seu projeto
NEXT_PUBLIC_SENTRY_DSN=

# Destino do mailto no formulário de feedback (padrão no código: codemancer07@gmail.com)
# NEXT_PUBLIC_FEEDBACK_EMAIL=

# Google OAuth (configurado no painel do Supabase > Authentication > Providers > Google)
# As credenciais do Google Cloud (Client ID e Secret) são configuradas diretamente no Supabase.
# Documentação: https://supabase.com/docs/guides/auth/social-login/auth-google
